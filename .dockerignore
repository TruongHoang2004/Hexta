# Ignore infrastructure data
infrastructure/.database
infrastructure/.redis
infrastructure/.elasticsearch
infrastructure/.minio
infrastructure/.loki
infrastructure/.prometheus

# Ignore project files
.git
.vscode
.idea
*.log

# Ignore module files that will be re-downloaded
**/vendor/
**/bin/
**/node_modules/
**/.next/
**/.turbo/

# Temporary files
/tmp/

# Host environments, local state and credentials must never enter build contexts.
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.env
**/.env.*
infrastructure/volumes/

# Connector service configuration. Values here are placeholders; never commit real secrets.
# Secrets are read from private files: each *_FILE variable holds a path, not the secret itself.

# Required
CONNECTOR_DATABASE_URL=postgres://connector_runtime:change-me@127.0.0.1:5432/hexta?sslmode=disable
KAFKA_BROKERS=127.0.0.1:9092
CONNECTOR_MANAGEMENT_TOKEN_FILE=/run/secrets/connector_management_token
# 32-byte AES-256-GCM key as 64 hex characters (e.g. `openssl rand -hex 32`). Rotating it requires owners to reconnect.
CONNECTOR_CREDENTIAL_KEY_FILE=/run/secrets/connector_credential_key

# Facebook (required by the connector today)
META_APP_ID=your-meta-app-id
META_APP_SECRET_FILE=/run/secrets/meta_app_secret
META_VERIFY_TOKEN_FILE=/run/secrets/meta_verify_token
# Optional overrides
META_GRAPH_URL=
META_GRAPH_VERSION=

# Telegram (optional). Unset TELEGRAM_WEBHOOK_BASE_URL disables Telegram management.
# Public HTTPS origin that reaches this connector's /webhooks/telegram/{connectionId}.
TELEGRAM_WEBHOOK_BASE_URL=
# Test override only; defaults to https://api.telegram.org.
TELEGRAM_API_URL=

CONNECTOR_LISTEN_ADDR=127.0.0.1:8091

# Live Telegram acceptance test only (TestLiveTelegramWebhookAcceptance); export in your shell, never commit.
# TELEGRAM_LIVE_BOT_TOKEN=
# TELEGRAM_LIVE_WEBHOOK_BASE_URL=
# TELEGRAM_LIVE_CONNECTOR_ADDR=127.0.0.1:18091
# TELEGRAM_LIVE_WAIT=5m

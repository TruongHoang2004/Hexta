# Candidate runtime: fake | gemini | openai | anthropic
# Real providers require their key; missing credentials fail startup.
AI_PROVIDER=openai
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional fallback key for the selected provider only.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_MAX_INPUT_TOKENS=16000
AI_TIMEOUT=20
AI_CONFIDENCE_THRESHOLD=0.8

# Synthetic local-only service credential; replace privately for shared environments.
AI_INTERNAL_TOKEN=local-dev-ai-internal-token-minimum-24-chars-long
LANGSMITH_TRACING=false
AI_GRPC_ENABLED=true
AI_GRPC_ADDRESS=127.0.0.1:55051
AI_DATABASE_URL=postgresql://hexta_ai:local-ai-only@127.0.0.1:55433/hexta_demo?sslmode=disable

# Smoke uses AI_INTERNAL_TOKEN; DEMO_AI_INTERNAL_TOKEN is a compatibility fallback.
DEMO_AI_URL=http://127.0.0.1:58000

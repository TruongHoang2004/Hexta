# Candidate runtime: fake | gemini | openai | anthropic (Claude is the default answer provider).
# Real providers require their key; missing credentials fail startup.
AI_PROVIDER=anthropic
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional fallback key for the selected provider only.
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_MAX_INPUT_TOKENS=16000
AI_TIMEOUT=20
AI_CONFIDENCE_THRESHOLD=0.8

# Synthetic local-only service credential; replace privately for shared environments.
AI_INTERNAL_TOKEN=local-dev-ai-internal-token-minimum-24-chars-long
LANGSMITH_TRACING=false
AI_GRPC_ENABLED=true
AI_GRPC_ADDRESS=127.0.0.1:55051
AI_DATABASE_URL=postgresql://hexta_ai:local-ai-only@127.0.0.1:55433/hexta_demo?sslmode=disable

# Smoke uses AI_INTERNAL_TOKEN; DEMO_AI_INTERNAL_TOKEN is a compatibility fallback.
DEMO_AI_URL=http://127.0.0.1:58000

# Jev (TypeSafe System One) router. Off until a key exists; without it routing keeps the existing classifier.
AI_JEV_ENABLED=false
TYPESAFE_API_KEY=
AI_JEV_MODEL=jev-1.14.0
AI_JEV_TIMEOUT=5
AI_JEV_TOTAL_TIMEOUT=12
AI_JEV_MAX_RETRIES=2
AI_JEV_MIN_PROBABILITY=0.6
AI_JEV_SCRIPT_MIN_PROBABILITY=0.6
AI_JEV_NOUL_YES=0.7
AI_JEV_NOUL_NO=0.3
AI_JEV_HISTORY_MESSAGES=2

# Knowledge (RAG) embeddings: fake (offline hashing) | gemini (uses GEMINI_API_KEY or AI_EMBEDDING_API_KEY).
AI_EMBEDDING_PROVIDER=fake
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_TIMEOUT=10
AI_RAG_TOP_K=6
AI_RAG_MIN_SIMILARITY=0.55
AI_RAG_MAX_CONTEXT_TOKENS=6000
AI_ANSWER_MIN_CONFIDENCE=0.7

# Copy to infrastructure/prod/.env on the server (chmod 600). Never commit the real file.
# Generate each secret with: openssl rand -hex 32
DOMAIN=hexta.org

# The image version comes from release.env (git) through scripts/deploy-agent.sh, not from this file.
# Defaults to ghcr.io/truonghoang2004/hexta; override only to use another registry.
# HEXTA_IMAGE_REGISTRY=

# Optional deploy notifications from scripts/deploy-agent.sh (a Telegram bot token and the chat to notify).
DEPLOY_NOTIFY_TELEGRAM_TOKEN=
DEPLOY_NOTIFY_TELEGRAM_CHAT_ID=
ACME_EMAIL=you@example.com

# Postgres superuser (used only by the database container and backups) and per-service logins.
POSTGRES_PASSWORD=
API_DB_PASSWORD=
AI_DB_PASSWORD=
CONNECTOR_DB_PASSWORD=

# API signing keys: two different values, each at least 32 characters.
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=

# Shared service tokens (at least 24 characters).
AI_INTERNAL_TOKEN=
CONNECTOR_MANAGEMENT_TOKEN=

# Optional Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI is OFF by default (owner decision 2026-11-26): the bot sends exact active scripts only and hands every other
# message to staff; no paid model is called. To enable it, set ALL of the following together (the AI service logs
# "AI disabled: <reason>" and stays off when any part is missing or inconsistent; it never fails startup):
#   AI_PROVIDER=anthropic  AI_MODEL=claude-sonnet-5-5  ANTHROPIC_API_KEY=<key>
#   AI_JEV_ENABLED=true    TYPESAFE_API_KEY=<key>
#   AI_EMBEDDING_PROVIDER=gemini  GEMINI_API_KEY=<key>
# then apply with ./scripts/prod.sh up -d --wait ai and run the knowledge re-sync (README.deploy.md, "AI settings").
AI_PROVIDER=disabled
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Jev router (TypeSafe System One). AI_JEV_ENABLED=true without TYPESAFE_API_KEY is logged as an error; Jev stays off.
AI_JEV_ENABLED=false
TYPESAFE_API_KEY=
# Knowledge embeddings: fake (offline hashing) | gemini (needs GEMINI_API_KEY; used only while AI is enabled).
# Chunks embedded with another model are ignored until re-embedded: after changing it, run the knowledge re-sync.
AI_EMBEDDING_PROVIDER=fake
AI_RAG_MIN_SIMILARITY=0.55

# Facebook channel (optional). The app secret and verify token live in secrets/ files, not here.
META_APP_ID=

# Only with compose.prod.shared-edge.yml: the existing reverse proxy's Docker network that Caddy joins.
# HEXTA_EDGE_NETWORK=infra-net

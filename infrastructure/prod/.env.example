# Copy to infrastructure/prod/.env on the server (chmod 600). Never commit the real file.
# Generate each secret with: openssl rand -hex 32
DOMAIN=hexta.org
ACME_EMAIL=you@example.com

# Postgres superuser (used only by the database container and backups) and per-service logins.
POSTGRES_PASSWORD=
API_DB_PASSWORD=
AI_DB_PASSWORD=
CONNECTOR_DB_PASSWORD=

# API signing keys: two different values, each at least 32 characters.
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=

# Shared service tokens (at least 24 characters).
AI_INTERNAL_TOKEN=
CONNECTOR_MANAGEMENT_TOKEN=

# Optional Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Python AI runtime: fake | gemini | openai | anthropic. Real providers need their key.
AI_PROVIDER=fake
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Facebook channel (optional). The app secret and verify token live in secrets/ files, not here.
META_APP_ID=

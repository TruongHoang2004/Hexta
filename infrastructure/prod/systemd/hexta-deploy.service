[Unit]
Description=Hexta deploy agent (applies infrastructure/prod/release.env from origin/main)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/hexta
ExecStart=/opt/hexta/scripts/deploy-agent.sh
# A first deploy pulls and starts every image; give it room but never hang forever.
TimeoutStartSec=30min

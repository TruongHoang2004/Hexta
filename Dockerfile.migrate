# Use golang alpine as the base so you have Go, apk, and a shell
FROM golang:1.22-alpine

# Install git and certificates
RUN apk add --no-cache ca-certificates git

# Copy the atlas binary from the official arigaio/atlas image
COPY --from=arigaio/atlas:latest /atlas /usr/local/bin/atlas

WORKDIR /workspace

# Copy your migration script
COPY scripts/migrate.sh /usr/local/bin/migrate.sh
RUN chmod +x /usr/local/bin/migrate.sh

ENTRYPOINT ["/usr/local/bin/migrate.sh"]